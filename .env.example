# Copier ce fichier en .env sur le serveur, puis remplir les valeurs.
# Ne JAMAIS commiter le fichier .env (il est dans .gitignore).
# Le script scripts/install-serveur.sh génère automatiquement les mots de passe.

# Nom de domaine qui pointe vers l'IP du serveur.
# Sans nom de domaine : utiliser <IP>.sslip.io, par exemple 51.210.10.20.sslip.io
DOMAIN=ticketstore.example.com

# Adresse e-mail pour Let's Encrypt (avis d'expiration des certificats)
ACME_EMAIL=toi@example.com

# Base de données
POSTGRES_USER=ticketstore_user
POSTGRES_PASSWORD=a-changer

# Redis
REDIS_PASSWORD=a-changer

# Compte admin Grafana (les étudiants y accèdent sans compte, en lecture seule)
GRAFANA_ADMIN_PASSWORD=a-changer

# Partie 3 du TP (Load Balancing) : décommenter pour démarrer le second backend
# COMPOSE_PROFILES=load-balancing

# Mémoire max de chaque backend Java (512m conseillé pour un serveur de 4 Go)
BACKEND_MAX_HEAP=512m
